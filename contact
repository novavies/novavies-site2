<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>CONTACT | Nova vies.</title>
  <meta name="description" content="Nova vies.へのお問い合わせ。チーム参加、個人レッスン、Youth、イベント、スポンサー・協業についてはこちらからご連絡ください。">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Noto+Sans+JP:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --black: #0A0A0A;
      --black-soft: #101010;
      --surface: #171717;
      --surface-2: #202020;
      --gold: #D4AF37;
      --gold-light: #F4E28D;
      --gold-mid: #B8960C;
      --gold-dark: #8B7200;
      --white: #F7F4EA;
      --text: #D8D8D8;
      --muted: #8F8F8F;
      --border: rgba(212,175,55,.22);
      --container: 1120px;
      --shadow-gold: 0 12px 40px rgba(212,175,55,.12);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background: var(--black);
      color: var(--white);
      font-family: "Noto Sans JP", sans-serif;
      font-weight: 300;
      line-height: 1.8;
      overflow-x: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    img {
      display: block;
      width: 100%;
    }

    button {
      font: inherit;
    }

    .container {
      width: min(calc(100% - 40px), var(--container));
      margin: 0 auto;
    }

    .font-heading {
      font-family: "Cormorant Garamond", serif;
    }

    .gold-gradient {
      background: linear-gradient(135deg, var(--gold), var(--gold-light), var(--gold-mid));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .section-label {
      color: var(--gold-light);
      font-size: 11px;
      letter-spacing: .28em;
      font-weight: 500;
      text-transform: uppercase;
    }

    .section-title {
      margin-top: 10px;
      font-family: "Cormorant Garamond", serif;
      font-size: clamp(34px, 5vw, 58px);
      font-weight: 400;
      line-height: 1.1;
    }

    .gold-line {
      width: 78px;
      height: 1px;
      margin: 26px 0 34px;
      background: linear-gradient(90deg, var(--gold), transparent);
    }

    .section-copy {
      color: var(--text);
      max-width: 720px;
      font-size: 15px;
      line-height: 2.05;
    }

    .muted {
      color: var(--muted);
    }

    /* =========================
       Navigation
    ========================== */
    .nav {
      position: fixed;
      inset: 0 0 auto 0;
      z-index: 1000;
      border-bottom: 1px solid rgba(212,175,55,.12);
      background: rgba(10,10,10,.88);
      backdrop-filter: blur(14px);
    }

    .nav-inner {
      height: 74px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
    }

    .brand {
      font-family: "Cormorant Garamond", serif;
      font-size: 28px;
      font-weight: 600;
      letter-spacing: .02em;
      background: linear-gradient(135deg, var(--gold), var(--gold-light), var(--gold-mid));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      white-space: nowrap;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 27px;
    }

    .nav-links a {
      color: #aaa;
      font-size: 11px;
      letter-spacing: .16em;
      transition: color .25s ease;
    }

    .nav-links a:hover {
      color: var(--gold-light);
    }

    .menu-btn {
      display: none;
      background: transparent;
      border: 0;
      color: var(--gold-light);
      font-size: 28px;
      cursor: pointer;
    }

    /* =========================
       Hero
    ========================== */
    .hero {
      min-height: 100svh;
      display: flex;
      align-items: center;
      position: relative;
      padding: 128px 0 80px;
      overflow: hidden;
      background:
        radial-gradient(circle at 75% 18%, rgba(212,175,55,.07), transparent 25%),
        radial-gradient(ellipse at 50% 0%, #1B1B1B 0%, #0A0A0A 67%);
    }

    .hero::before {
      content: "";
      position: absolute;
      inset: 0;
      opacity: .12;
      background-image:
        radial-gradient(circle at 20% 50%, var(--gold) 1px, transparent 1px),
        radial-gradient(circle at 80% 20%, var(--gold) 1px, transparent 1px);
      background-size: 105px 105px;
      pointer-events: none;
    }

    .hero::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 130px;
      background: linear-gradient(transparent, var(--black));
      pointer-events: none;
    }

    .hero-inner {
      position: relative;
      z-index: 2;
      max-width: 880px;
      text-align: center;
    }

    .hero-kicker {
      color: var(--gold-light);
      font-size: 12px;
      letter-spacing: .34em;
      margin-bottom: 25px;
    }

    .hero h1 {
      font-family: "Cormorant Garamond", serif;
      font-size: clamp(54px, 9vw, 108px);
      font-weight: 300;
      line-height: .92;
      letter-spacing: -.02em;
      background: linear-gradient(135deg, #fff9dd 5%, var(--gold-light) 42%, var(--gold) 75%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      text-shadow: 0 0 70px rgba(212,175,55,.04);
    }

    .hero-copy {
      margin-top: 34px;
      color: #f0eee6;
      font-size: clamp(18px, 2.4vw, 27px);
      letter-spacing: .08em;
      font-weight: 400;
    }

    .hero-sub {
      margin: 17px auto 0;
      max-width: 660px;
      color: #999;
      font-size: 14px;
      line-height: 1.9;
    }

    .hero-actions,
    .actions {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 14px;
      margin-top: 39px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 50px;
      padding: 0 30px;
      border: 1px solid rgba(212,175,55,.48);
      border-radius: 3px;
      color: var(--gold-light);
      font-size: 12px;
      font-weight: 500;
      letter-spacing: .12em;
      transition: .25s ease;
    }

    .btn:hover {
      border-color: var(--gold-light);
      background: rgba(212,175,55,.06);
      transform: translateY(-2px);
    }

    .btn-primary {
      color: #080808;
      border-color: transparent;
      background: linear-gradient(135deg, var(--gold), var(--gold-mid));
      font-weight: 700;
    }

    .btn-primary:hover {
      color: #080808;
      background: linear-gradient(135deg, var(--gold-light), var(--gold));
      box-shadow: 0 10px 30px rgba(212,175,55,.18);
    }

    /* =========================
       Sections
    ========================== */
    .section {
      padding: 112px 0;
      position: relative;
    }

    .section-dark {
      background: var(--black-soft);
    }

    .section-center {
      text-align: center;
    }

    .section-center .gold-line {
      margin-left: auto;
      margin-right: auto;
      background: linear-gradient(90deg, transparent, var(--gold), transparent);
    }

    .section-center .section-copy {
      margin-left: auto;
      margin-right: auto;
    }

    /* =========================
       About
    ========================== */
    .about-intro {
      max-width: 850px;
    }

    .about-intro .lead {
      color: #e2e2e2;
      font-size: 17px;
      line-height: 2.05;
      margin-bottom: 22px;
    }

    /* =========================
       Activities
    ========================== */
    .activities-grid {
      margin-top: 48px;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 18px;
    }

    .activity-card {
      position: relative;
      min-height: 320px;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 32px;
      overflow: hidden;
      border: 1px solid var(--border);
      border-radius: 5px;
      background: #131313;
      transition: transform .3s ease, border-color .3s ease, box-shadow .3s ease;
    }

    .activity-card:hover {
      transform: translateY(-4px);
      border-color: rgba(244,226,141,.6);
      box-shadow: var(--shadow-gold);
    }

    .activity-card::before {
      content: "";
      position: absolute;
      inset: 0;
      background:
        linear-gradient(180deg, rgba(0,0,0,.06), rgba(0,0,0,.9)),
        radial-gradient(circle at 85% 15%, rgba(212,175,55,.12), transparent 28%);
      z-index: 0;
    }

    .activity-card > * {
      position: relative;
      z-index: 1;
    }

    .activity-number {
      color: var(--gold);
      font-family: "Cormorant Garamond", serif;
      font-size: 14px;
      letter-spacing: .12em;
      margin-bottom: 7px;
    }

    .activity-card h3 {
      font-family: "Cormorant Garamond", serif;
      font-size: 31px;
      font-weight: 400;
      margin-bottom: 5px;
    }

    .activity-card p {
      color: #aaa;
      font-size: 13px;
      line-height: 1.8;
      max-width: 360px;
    }

    .activity-link {
      color: var(--gold-light);
      font-size: 11px;
      letter-spacing: .14em;
      margin-top: 20px;
    }

    /* =========================
       Stats
    ========================== */
    .stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      border: 1px solid var(--border);
      background: #101010;
    }

    .stat {
      min-height: 155px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      border-right: 1px solid var(--border);
      text-align: center;
    }

    .stat:last-child {
      border-right: 0;
    }

    .stat strong {
      display: block;
      font-family: "Cormorant Garamond", serif;
      color: var(--gold-light);
      font-size: 34px;
      font-weight: 400;
      line-height: 1;
    }

    .stat span {
      display: block;
      margin-top: 12px;
      color: #777;
      font-size: 10px;
      letter-spacing: .17em;
      text-transform: uppercase;
    }

    /* =========================
       Coaching
    ========================== */
    .split {
      display: grid;
      grid-template-columns: 1.02fr .98fr;
      gap: 74px;
      align-items: center;
    }

    .badge {
      display: inline-block;
      padding: 7px 11px;
      color: var(--gold-light);
      border: 1px solid var(--border);
      font-size: 10px;
      letter-spacing: .22em;
    }

    .coaching-photo {
      position: relative;
      min-height: 520px;
      border: 1px solid var(--border);
      overflow: hidden;
      background:
        linear-gradient(145deg, #252525, #101010 65%);
    }

    .coaching-photo img {
      width: 100%;
      height: 100%;
      min-height: 520px;
      object-fit: cover;
      filter: saturate(.7) contrast(1.07);
    }

    .coaching-photo::after {
      content: "";
      position: absolute;
      inset: 0;
      box-shadow: inset 0 0 70px rgba(0,0,0,.65);
      pointer-events: none;
    }

    /* =========================
       Three pillars
    ========================== */
    .three-grid {
      margin-top: 46px;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 17px;
    }

    .simple-card {
      padding: 32px 28px;
      min-height: 230px;
      border: 1px solid var(--border);
      background: #121212;
      transition: .25s ease;
    }

    .simple-card:hover {
      border-color: rgba(244,226,141,.5);
      transform: translateY(-3px);
    }

    .simple-card .tag {
      color: var(--gold);
      font-size: 10px;
      letter-spacing: .22em;
    }

    .simple-card h3 {
      margin-top: 16px;
      font-family: "Cormorant Garamond", serif;
      font-size: 29px;
      font-weight: 400;
    }

    .simple-card p {
      margin-top: 14px;
      color: #9c9c9c;
      font-size: 13px;
      line-height: 1.85;
    }

    /* =========================
       CTA / Footer
    ========================== */
    .cta {
      padding: 110px 0;
      text-align: center;
      position: relative;
      overflow: hidden;
      background:
        linear-gradient(rgba(10,10,10,.8), rgba(10,10,10,.95)),
        radial-gradient(circle at 50% 50%, rgba(212,175,55,.15), transparent 42%);
      border-top: 1px solid rgba(212,175,55,.12);
    }

    .cta .section-title {
      max-width: 760px;
      margin-left: auto;
      margin-right: auto;
    }

    .footer {
      padding: 45px 0 34px;
      border-top: 1px solid rgba(212,175,55,.1);
      color: #666;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 30px;
      align-items: end;
    }

    .footer .brand {
      display: inline-block;
      font-size: 25px;
    }

    .footer-note {
      margin-top: 6px;
      font-size: 10px;
      letter-spacing: .1em;
    }

    .footer-links {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 18px;
    }

    .footer-links a {
      color: #777;
      font-size: 10px;
      letter-spacing: .12em;
    }

    .copyright {
      margin-top: 26px;
      font-size: 9px;
      color: #555;
    }

    /* =========================
       Animation
    ========================== */
    .fade {
      opacity: 0;
      transform: translateY(28px);
      transition: opacity .8s ease, transform .8s ease;
    }

    .fade.show {
      opacity: 1;
      transform: translateY(0);
    }

    /* =========================
       Responsive
    ========================== */
    @media (max-width: 900px) {
      .menu-btn {
        display: block;
      }

      .nav-links {
        position: absolute;
        top: 74px;
        left: 0;
        right: 0;
        display: none;
        flex-direction: column;
        align-items: stretch;
        gap: 0;
        padding: 12px 20px 22px;
        border-bottom: 1px solid var(--border);
        background: rgba(10,10,10,.98);
      }

      .nav-links.open {
        display: flex;
      }

      .nav-links a {
        padding: 13px 4px;
        border-bottom: 1px solid rgba(255,255,255,.05);
      }

      .activities-grid,
      .split {
        grid-template-columns: 1fr;
      }

      .stats {
        grid-template-columns: repeat(2, 1fr);
      }

      .stat:nth-child(2) {
        border-right: 0;
      }

      .stat:nth-child(-n+2) {
        border-bottom: 1px solid var(--border);
      }

      .three-grid {
        grid-template-columns: 1fr;
      }

      .coaching-photo,
      .coaching-photo img {
        min-height: 390px;
      }

      .footer-grid {
        grid-template-columns: 1fr;
        align-items: start;
      }

      .footer-links {
        justify-content: flex-start;
      }
    }

    @media (max-width: 580px) {
      .container {
        width: min(calc(100% - 32px), var(--container));
      }

      .section {
        padding: 84px 0;
      }

      .hero {
        min-height: 92svh;
        padding-top: 112px;
      }

      .hero h1 {
        font-size: 55px;
      }

      .hero-copy {
        font-size: 17px;
      }

      .hero-sub {
        font-size: 12px;
      }

      .hero-actions,
      .actions {
        flex-direction: column;
      }

      .btn {
        width: 100%;
      }

      .activities-grid {
        grid-template-columns: 1fr;
      }

      .activity-card {
        min-height: 260px;
      }

      .stats {
        grid-template-columns: 1fr;
      }

      .stat,
      .stat:nth-child(2) {
        border-right: 0;
        border-bottom: 1px solid var(--border);
      }

      .stat:last-child {
        border-bottom: 0;
      }

      .section-title {
        font-size: 39px;
      }
    }
  </style>
  
