const t=document.querySelectorAll(".fade");
if("IntersectionObserver"in window){const o=new IntersectionObserver(e=>e.forEach(x=>{if(x.isIntersecting){x.target.classList.add("show");o.unobserve(x.target)}}),{threshold:.08});t.forEach(x=>o.observe(x))}else t.forEach(x=>x.classList.add("show"));
});
