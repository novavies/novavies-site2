.page-hero::before{content:"";position:absolute;inset:0;opacity:.10;background-image:radial-gradient(circle at 20% 50%,var(--gold) 1px,transparent 1px),radial-gradient(circle at 80% 20%,var(--gold) 1px,transparent 1px);background-size:105px 105px}
